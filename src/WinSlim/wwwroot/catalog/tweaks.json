  "tweaks": [
    {
      "id": "telemetry-min",
      "category": "privacy",
      "title": "把诊断数据降到最低",
      "desc": "Windows 会持续把诊断数据（设备信息、崩溃、使用情况）上传给微软。这项把组策略“允许诊断数据”设为最低级别。",
      "effect": "上传的数据量减少，后台的 DiagTrack 活动随之减少。专业版及以下会降到“必需的诊断数据”，企业版和教育版会完全关闭。",
      "risk": "Windows 预览体验计划需要完整诊断数据，开启后无法再获取预览版。“设置”顶部会显示“某些设置由组织管理”。",
      "level": "safe", "os": "all", "restart": "none", "recommended": true,
      "actions": [
        { "type": "reg", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "dword", "value": 0 }
      ]
    },
    {
      "id": "advertising-id",
      "category": "privacy",
      "title": "关闭广告 ID",
      "desc": "广告 ID 是每个用户唯一的标识符，应用可以用它跨应用追踪你，从而投放个性化广告。",
      "effect": "应用无法再通过广告 ID 关联你的行为，广告不再个性化。",
      "risk": "没有功能损失。广告数量不会减少，只是不再“精准”。",
      "level": "safe", "os": "all", "restart": "none", "recommended": true,
      "actions": [
        { "type": "reg", "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo", "name": "Enabled", "kind": "dword", "value": 0 },
        { "type": "reg", "path": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "kind": "dword", "value": 1 }
      ]
    },
